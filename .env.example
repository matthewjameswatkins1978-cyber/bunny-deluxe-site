# Never put live values in this file or commit a real .env file.
# Use test-mode Stripe credentials until the final launch review.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public HTTPS address of this service. Inkthreadable must be able to fetch
# /print-files/... from this address after a payment.
SITE_URL=https://shop.example.com
PORT=4173

# Inkthreadable API Settings values. The secret is only used server-side to
# create the SHA-1 request signature; never expose it to the browser.
INKTHREADABLE_APP_ID=
INKTHREADABLE_SECRET_KEY=
INKTHREADABLE_BRAND_NAME=Bunny Deluxe
# Exact name of the DTF neck label uploaded under this Brand Profile.
# The API adds this label to every paid shirt order; do not guess it.
INKTHREADABLE_LABEL_NAME=
INKTHREADABLE_SHIPPING_METHOD=regular

# Directory containing the six 8-bit print-upload PNGs. In production this
# directory must be deployed with persistent public access through this app.
PRINT_FILE_DIRECTORY=./print-files

# Must be persistent storage in production. A local file is fine for local dev.
ORDER_JOURNAL_PATH=./data/fulfilment-journal.json
